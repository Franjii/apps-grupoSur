# Copiá a .env y completá. En desarrollo alcanza con DEV_AUTH_BYPASS=1.

ADDR=:8080
BASE_URL=https://estadisticas.gruposur.ar
LOGIN_URL=https://login.gruposur.ar
COOKIE_DOMAIN=.gruposur.ar
SECURE_COOKIE=1
SESSION_KEY=cambiá-esto-por-una-clave-larga-aleatoria
DB_PATH=data/gruposur.db
ADMIN_EMAILS=sebastian.chapartegui@gruposur.ar

# Google OAuth (obligatorio en producción)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://login.gruposur.ar/auth/callback

# Desarrollo: saltea OAuth e inicia sesión como DEV_USER_EMAIL
DEV_AUTH_BYPASS=0
DEV_USER_EMAIL=sebastian.chapartegui@gruposur.ar

# Módulo Inventario (app aparte, inventory-webapp, en su propio subdominio)
INVENTARIO_BASE_URL=https://inventario.gruposur.ar

# SSO bridge: secreto compartido con las apps-módulo que introspectan sesiones
# (mismo valor en el .env de inventory-webapp). Vacío => /auth/introspect deshabilitado.
SSO_SHARED_SECRET=
