package pages

import "inventory-webapp/templates"

templ LoginPage(errorMsg string, successMsg string) {
	@templates.BaseLogin("Iniciar Sesión") {
		<div class="login-container">
			<div class="login-logo">
				<img src="/static/images/logo.png" alt="GrupoSur" class="login-logo-img"/>
			</div>
			<h1>Iniciar Sesión</h1>
			@templates.ErrorMessage(errorMsg)
			@templates.SuccessMessage(successMsg)
			<form method="POST" action="/login">
				@templates.CSRFInput()
				<div class="form-group">
					<label for="username">Usuario</label>
					<input type="text" id="username" name="username" required maxlength="255" autofocus/>
				</div>
				<div class="form-group">
					<label for="password">Contraseña</label>
					<input type="password" id="password" name="password" required maxlength="72"/>
				</div>
				<button type="submit" class="btn btn-primary btn-block">Ingresar</button>
			</form>
			<p class="text-center text-muted text-sm mt-2">
				<a href="/forgot-password">¿Olvidaste tu contraseña?</a>
			</p>
		</div>
	}
}
