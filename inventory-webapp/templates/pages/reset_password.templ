package pages

import "inventory-webapp/templates"

templ ResetPasswordPage(token string, errorMsg string) {
	@templates.BaseLogin("Restablecer Contraseña") {
		<div class="login-container">
			<div class="login-logo">
				<img src="/static/images/logo.png" alt="GrupoSur" class="login-logo-img"/>
			</div>
			<h1>Restablecer Contraseña</h1>
			@templates.ErrorMessage(errorMsg)
			<form method="POST" action="/reset-password">
				@templates.CSRFInput()
				<input type="hidden" name="token" value={ token }/>
				<div class="form-group">
					<label for="password">Nueva Contraseña</label>
					<input type="password" id="password" name="password" required minlength="6" maxlength="72" autofocus/>
				</div>
				<div class="form-group">
					<label for="confirm_password">Confirmar Contraseña</label>
					<input type="password" id="confirm_password" name="confirm_password" required minlength="6" maxlength="72"/>
				</div>
				<button type="submit" class="btn btn-primary btn-block">Guardar Contraseña</button>
			</form>
			@templates.BackToLoginLink()
		</div>
	}
}
