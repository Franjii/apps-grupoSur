package pages

import "inventory-webapp/templates"

templ ForgotPasswordPage(errorMsg string, successMsg string) {
	@templates.BaseLogin("Recuperar Contraseña") {
		<div class="login-container">
			<div class="login-logo">
				<img src="/static/images/logo.png" alt="GrupoSur" class="login-logo-img"/>
			</div>
			<h1>Recuperar Contraseña</h1>
			<p class="text-center text-muted text-sm mb-2">
				Ingrese su email y le enviaremos un enlace para restablecer su contraseña.
			</p>
			@templates.ErrorMessage(errorMsg)
			@templates.SuccessMessage(successMsg)
			if successMsg == "" {
				<form method="POST" action="/forgot-password">
					@templates.CSRFInput()
					<div class="form-group">
						<label for="email">Email</label>
						<input type="email" id="email" name="email" required maxlength="320" autofocus/>
					</div>
					<button type="submit" class="btn btn-primary btn-block">Enviar Enlace</button>
				</form>
			}
			@templates.BackToLoginLink()
		</div>
	}
}
