package pages

import "inventory-webapp/templates"

templ ResetPasswordExpiredPage(message string) {
	@templates.BaseLogin("Enlace Expirado") {
		<div class="login-container">
			<div class="login-logo">
				<img src="/static/images/logo.png" alt="GrupoSur" class="login-logo-img"/>
			</div>
			<h1>Enlace No Válido</h1>
			@templates.ErrorMessage(message)
			<p class="text-center text-muted text-sm mt-2">
				Puede solicitar un nuevo enlace desde la página de recuperación de contraseña.
			</p>
			<div class="text-center mt-2">
				<a href="/forgot-password" class="btn btn-primary">Solicitar Nuevo Enlace</a>
			</div>
			@templates.BackToLoginLink()
		</div>
	}
}
